save-exact=true
# Increase available heap size to avoid running out of memory when compiling.
# This applies to all npm scripts in this repository, and overrides any NODE_OPTIONS inherited
# from the environment — so this is the only place worth changing it.
# 8192 was not enough for `npm run lint`: type-aware ESLint over this monorepo peaks at ~10.4 GB
# RSS (measured), so it aborted with "Ineffective mark-compacts near heap limit".
node-options=--max-old-space-size=12288
