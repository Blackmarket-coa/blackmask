# Copy to .env and fill in. NEVER commit the filled-in file. The .gitignore in this directory
# covers it — the repo root .gitignore does not, so do not move .env elsewhere.
#
# Generate secrets with:  openssl rand -base64 48

# Public origin, including scheme. Must match the hostname the tunnel serves.
# Use exactly https://vault.blackmask.app so the browser extension's built-in region config
# matches and users never have to type a server address.
DOMAIN=https://vault.blackmask.app

# Turn this off once your own accounts exist. Left on, anyone who finds the URL can register.
SIGNUPS_ALLOWED=true

# Paid Have I Been Pwned API key. Without it, GET /hibp/breach returns an error and the Black Mask
# data exposure dashboard shows an error card instead of breach data.
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Postgres. DATABASE_URL must agree with the three POSTGRES_* values and use the compose service
# name as the host.
POSTGRES_USER=blackmask
POSTGRES_PASSWORD=
POSTGRES_DB=vaultwarden
DATABASE_URL=postgresql://blackmask:CHANGE_ME@postgres:5432/vaultwarden

# Argon2 PHC string, not a raw password. Generate with:  docker run --rm -it vaultwarden/server:1.36.0 /vaultwarden hash
# Leave empty to disable /admin entirely, which is the safer default once setup is done.
ADMIN_TOKEN=

# From the Cloudflare Zero Trust dashboard when you create the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
